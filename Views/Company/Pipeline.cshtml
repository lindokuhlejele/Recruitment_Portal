@model List<Recruitment_Portal.ViewModels.PipelineApplicantVM>

@{
    ViewBag.Title = "Applications Pipeline";
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<div class="flex min-h-screen bg-gray-950 text-white">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-gray-900 border-r border-gray-800 p-5">

        <h1 class="text-2xl font-bold text-[#D4AF37] mb-8">
            Company Portal
        </h1>

        <nav class="space-y-3">

            <a href="/Company/Dashboard"
               class="block py-2 px-3 rounded hover:bg-gray-800">
                Dashboard
            </a>

            <a href="/Company/Opportunities"
               class="block py-2 px-3 rounded hover:bg-gray-800">
                Opportunities
            </a>

            <a href="/Company/Applications"
               class="block py-2 px-3 rounded bg-gray-800">
                Applications
            </a>

            <a href="/Company/Users"
               class="block py-2 px-3 rounded hover:bg-gray-800">
                Company Users
            </a>

            <a href="/Company/Profile"
               class="block py-2 px-3 rounded hover:bg-gray-800">
                Company Profile
            </a>

        </nav>

    </aside>

    <!-- MAIN -->
    <div class="flex-1 p-8">

        <div class="mb-8">

            <h1 class="text-3xl font-bold">
                Recruitment Pipeline
            </h1>

            <p class="text-gray-400">
                Manage applicant progression through the hiring process
            </p>

        </div>

        <div class="grid grid-cols-5 gap-4">

            <!-- APPLIED -->
            <div class="bg-gray-900 rounded-xl p-4">

                <h2 class="font-bold text-lg mb-4 text-blue-400">
                    Applied
                </h2>

                @foreach (var item in Model.Where(x => x.Status == "Applied"))
                {
                    <div class="bg-gray-800 rounded-lg p-3 mb-3">

                        <div class="font-semibold">
                            @item.FullName
                        </div>

                        <div class="text-sm text-gray-400">
                            @item.Email
                        </div>

                        <div class="mt-3 flex gap-2">

                            <button onclick="moveApplicant('@item.ApplicationId','Shortlisted')"
                                    class="bg-green-600 px-3 py-1 rounded text-xs">
                                Shortlist
                            </button>

                            <button onclick="moveApplicant('@item.ApplicationId','Rejected')"
                                    class="bg-red-600 px-3 py-1 rounded text-xs">
                                Reject
                            </button>

                        </div>

                    </div>
                }

            </div>

            <!-- SHORTLISTED -->
            <div class="bg-gray-900 rounded-xl p-4">

                <h2 class="font-bold text-lg mb-4 text-yellow-400">
                    Shortlisted
                </h2>

                @foreach (var item in Model.Where(x => x.Status == "Shortlisted"))
                {
                    <div class="bg-gray-800 rounded-lg p-3 mb-3">

                        <div class="font-semibold">
                            @item.FullName
                        </div>

                        <div class="text-sm text-gray-400">
                            @item.Email
                        </div>

                        <button onclick="openInterviewModal('@item.ApplicationId')"
                                class="mt-3 bg-blue-600 px-3 py-1 rounded text-xs">
                            Schedule Interview
                        </button>

                    </div>
                }

            </div>

            <!-- INTERVIEW -->
            <div class="bg-gray-900 rounded-xl p-4">

                <h2 class="font-bold text-lg mb-4 text-purple-400">
                    Interview
                </h2>

                @foreach (var item in Model.Where(x => x.Status == "Interview"))
                {
                    <div class="bg-gray-800 rounded-lg p-3 mb-3">

                        <div class="font-semibold">
                            @item.FullName
                        </div>

                        <div class="text-sm text-gray-400">
                            @item.Email
                        </div>

                        <div class="mt-3 flex gap-2">

                            <button onclick="moveApplicant('@item.ApplicationId','Hired')"
                                    class="bg-green-600 px-3 py-1 rounded text-xs">
                                Hire
                            </button>

                            <button onclick="moveApplicant('@item.ApplicationId','Rejected')"
                                    class="bg-red-600 px-3 py-1 rounded text-xs">
                                Reject
                            </button>

                        </div>

                    </div>
                }

            </div>

            <!-- HIRED -->
            <div class="bg-gray-900 rounded-xl p-4">

                <h2 class="font-bold text-lg mb-4 text-green-400">
                    Hired
                </h2>

                @foreach (var item in Model.Where(x => x.Status == "Hired"))
                {
                    <div class="bg-green-900 rounded-lg p-3 mb-3">
                        <div class="font-semibold">
                            @item.FullName
                        </div>
                    </div>
                }

            </div>

            <!-- REJECTED -->
            <div class="bg-gray-900 rounded-xl p-4">

                <h2 class="font-bold text-lg mb-4 text-red-400">
                    Rejected
                </h2>

                @foreach (var item in Model.Where(x => x.Status == "Rejected"))
                {
                    <div class="bg-red-900 rounded-lg p-3 mb-3">
                        <div class="font-semibold">
                            @item.FullName
                        </div>
                    </div>
                }

            </div>

        </div>

    </div>

</div>

<!-- INTERVIEW MODAL -->

<div id="interviewModal"
     class="fixed inset-0 hidden bg-black/70 items-center justify-center z-50">

    <div class="bg-gray-900 rounded-2xl p-6 w-full max-w-lg border border-gray-700">

        <div class="flex justify-between items-center mb-5">

            <h2 class="text-xl font-bold">
                Schedule Interview
            </h2>

            <button onclick="closeInterviewModal()"
                    class="text-gray-400 hover:text-white text-2xl">
                ×
            </button>

        </div>

        <input type="hidden" id="applicationId" />

        <div class="mb-4">

            <label class="block text-sm mb-2">
                Interview Date & Time
            </label>

            <input type="datetime-local"
                   id="interviewDate"
                   class="w-full bg-gray-800 rounded-lg p-3 border border-gray-700">

        </div>

        <div class="mb-4">

            <label class="block text-sm mb-2">
                Interview Mode
            </label>

            <select id="interviewMode"
                    class="w-full bg-gray-800 rounded-lg p-3 border border-gray-700">

                <option value="Online">Online</option>
                <option value="Physical">Physical</option>

            </select>

        </div>

        <div class="mb-4">

            <label class="block text-sm mb-2">
                Notes
            </label>

            <textarea id="notes"
                      rows="4"
                      class="w-full bg-gray-800 rounded-lg p-3 border border-gray-700"
                      placeholder="Interview details, venue, meeting link, etc"></textarea>

        </div>

        <button onclick="scheduleInterview()"
                class="w-full bg-[#D4AF37] text-black font-bold py-3 rounded-lg">
            Schedule Interview
        </button>

    </div>

</div>

<script>

    function moveApplicant(id, status) {

        $.post('/Company/UpdateApplicationStatus',
            {
                id: id,
                status: status
            },
            function (res) {

                if (res.success) {

                    location.reload();
                }
                else {

                    alert(res.message);
                }
            });
    }

    function openInterviewModal(id) {

        console.log("Opening Interview For:", id);

        $("#applicationId").val(id);

        $("#interviewModal")
            .removeClass("hidden")
            .addClass("flex");
    }

    function closeInterviewModal() {

        $("#interviewModal")
            .removeClass("flex")
            .addClass("hidden");
    }

    function scheduleInterview() {

        console.log("ApplicationId:",
            $("#applicationId").val());

        $.ajax({

            url: '/Company/ScheduleInterview',
            type: 'POST',

            data: {
                ApplicationId: $("#applicationId").val(),
                InterviewDate: $("#interviewDate").val(),
                Mode: $("#interviewMode").val(),
                Notes: $("#notes").val()
            },

            success: function (res) {

                console.log(res);

                if (res.success) {

                    alert("Interview Scheduled");

                    moveApplicant(
                        $("#applicationId").val(),
                        "Interview");
                }
                else {

                    alert(res.message);
                }
            },

            error: function (xhr) {

                console.log(xhr.responseText);

                alert("Error scheduling interview");
            }
        });
    }

</script>