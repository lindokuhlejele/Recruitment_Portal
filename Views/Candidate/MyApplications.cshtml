@{

    @model List<Recruitment_Portal.Models.MyApplicationVM>
    var missing = ViewBag.MissingFields as List<string> ?? new List<string>();
}
<div class="bg-gray-100 py-6 px-4">

    <!-- CENTER CONTAINER (keeps alignment with dashboard) -->
    <div class="max-w-7xl mx-auto space-y-6">

        <!-- PROFILE HEADER CARD -->
        <div class="bg-white rounded-xl shadow p-6 border border-gray-100">

            <div class="flex flex-col lg:flex-row lg:justify-between lg:items-center gap-4">

                <div>
                    <h2 class="font-bold text-xl">
                        Welcome, KZN Young Citizen
                    </h2>

                    <p class="text-sm text-gray-500 mt-1">
                        Verify details, match regional job listings, and control your POPIA compliance data.
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-3">

                    <span class="text-xs bg-green-50 text-green-700 px-3 py-2 rounded-full font-medium">
                        ROLE: CANDIDATE
                    </span>

                    <button class="text-sm border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-100">
                        Sign Out
                    </button>

                    <button class="text-sm bg-red-50 text-red-600 px-4 py-2 rounded-lg hover:bg-red-100">
                        POPIA Purge Profile
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>



<div class="bg-gray-100 min-h-screen py-8">

    <div class="max-w-7xl mx-auto px-4">

        <div class="bg-white rounded-3xl shadow-xl border border-gray-200 overflow-hidden">

            <div class="flex gap-6 p-6 bg-gray-50">

                <!-- LEFT SIDEBAR -->
                <div class="w-80">
                    <div class="w-80 space-y-4">



                        <!-- PROFILE INTEGRITY CARD -->
                        <!---data-->
                        <div class="bg-white rounded-xl shadow p-4">

                            <h3 class="text-sm font-semibold mb-3">PROFILE INTEGRITY METER</h3>

                            @*<div class="w-full bg-gray-200 rounded-full h-2">
                                    <div class="bg-green-500 h-2 rounded-full"
                                         style="width:@ViewBag.Completion%"></div>
                                </div>

                                <p class="text-xs mt-1 text-gray-500">
                                    @ViewBag.Completion% Complete
                                </p>*@

                            @if (missing.Count > 0)
                            {
                                <div class="mt-3">
                                    <p class="text-xs text-red-500 font-semibold">Missing Fields:</p>

                                    <ul class="text-xs text-gray-600 mt-1 space-y-1">
                                        @foreach (var m in missing)
                                        {
                                            <li>• @m</li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <p class="text-xs text-green-600 mt-2 font-semibold">
                                    Profile fully completed 🎉
                                </p>
                            }

                        </div>

                        <!-- MENU CARD -->
                        <div class="bg-white rounded-xl shadow p-4">

                            <div class="space-y-2">
                                <a href="@Url.Action("Dashboard", "Candidate")"
                                   class="block text-sm text-green-800 font-semibold px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    Dashboard
                                </a>
                                <a href="@Url.Action("UserProfile", "Candidate")"
                                   class="block text-sm text-gray-700 px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    My Resume Profile
                                </a>
                                <a href="@Url.Action("Index", "WorkExperience")"
                                   class="block text-sm text-gray-700 px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    Work Experience
                                </a>
                                <a href="@Url.Action("Index", "Education")"
                                   class="block text-sm text-gray-700 px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    Education
                                </a>
                                <a href="@Url.Action("MyApplications","Candidate")"
                                   class="block text-sm text-gray-700 px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    My Applications
                                </a>


                            </div>
                        </div>

                        <!-- CV UPLOAD CARD -->
                        <div class="bg-white rounded-xl shadow p-4 text-center">

                            <h3 class="text-sm font-semibold mb-2">QUALIFICATION CV ATTACHMENT</h3>

                            <div class="border-2 border-dashed rounded-lg p-4 text-xs text-gray-500">
                                Click to load qualifying CV<br>
                                PDF, DOC up to 5MB
                            </div>

                        </div>

                        <!-- SUBMISSIONS CARD -->
                        <div class="bg-white rounded-xl shadow p-4">
                            <h3 class="text-sm font-semibold">ACTIONED SUBMISSIONS (0)</h3>
                            <p class="text-xs text-gray-400 mt-2">No submissions made yet.</p>
                        </div>

                    </div>
                </div>

                <!-- MAIN DASHBOARD CONTENT (FORM AREA REPLACED) -->
                <div class="flex-1 space-y-6">



                    <div class="min-h-screen bg-gray-950 text-white p-8">

                        <h1 class="text-3xl font-bold mb-6">
                            My Applications
                        </h1>

                        <div class="grid md:grid-cols-2 gap-6">

                            @foreach (var item in Model)
                            {
                                <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">

                                    <!-- JOB TITLE -->
                                    <h2 class="text-xl font-bold">
                                        @item.JobTitle
                                    </h2>

                                    <div class="text-gray-400 text-sm mt-1">
                                        @item.CompanyName
                                    </div>

                                    <div class="text-gray-400 text-sm">
                                        📍 @item.Location
                                    </div>

                                    <!-- STATUS BADGE -->
                                    <div class="mt-3">
                                        <span class="px-3 py-1 rounded-full text-xs
                        @(item.Status == "Applied" ? "bg-blue-600" :
                          item.Status == "Shortlisted" ? "bg-yellow-600" :
                          item.Status == "Rejected" ? "bg-red-600" :
                          item.Status == "Interview" ? "bg-purple-600" :
                          "bg-green-600")">

                                            @item.Status
                                        </span>
                                    </div>

                                    <!-- DATES -->
                                    <div class="mt-3 text-sm text-gray-400">
                                        Applied:
                                        @item.AppliedAt?.ToString("dd MMM yyyy")
                                    </div>

                                    <div class="text-sm text-gray-400">
                                        Closing:
                                        @item.ClosingDate?.ToString("dd MMM yyyy")
                                    </div>

                                    <!-- ACTION -->
                                    <div class="mt-5">

                                        <a href="@Url.Action("Details","Opportunities", new { id = item.OpportunityId })"
                                           class="bg-[#D4AF37] text-black px-4 py-2 rounded-lg font-bold block text-center">

                                            View Opportunity

                                        </a>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>
</div>


