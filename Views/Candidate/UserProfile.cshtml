@{

    bool isEditMode = ViewBag.IsEditMode ?? false;

    //var percent = ViewBag.ProfileCompletion ?? 0;
    //var missing = ViewBag.MissingFields as List<string> ?? new List<string>();
    var completion = Model?.profile_completion ?? 0;
    var missing = ViewBag.MissingFields as List<string> ?? new List<string>();
}




<div class="bg-gray-100 py-6 px-4">

    <!-- CENTER CONTAINER (keeps alignment with dashboard) -->
    <div class="max-w-7xl mx-auto space-y-6">

        <!-- PROFILE HEADER CARD -->
        <div class="bg-white rounded-xl shadow p-6 border border-gray-100">

            <div class="flex flex-col lg:flex-row lg:justify-between lg:items-center gap-4">

                <div>
                    <h2 class="font-bold text-xl">
                        Welcome, KZN Young Citizen
                    </h2>

                    <p class="text-sm text-gray-500 mt-1">
                        Verify details, match regional job listings, and control your POPIA compliance data.
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-3">

                    <span class="text-xs bg-green-50 text-green-700 px-3 py-2 rounded-full font-medium">
                        ROLE: CANDIDATE
                    </span>

                    <button class="text-sm border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-100">
                        Sign Out
                    </button>

                    <button class="text-sm bg-red-50 text-red-600 px-4 py-2 rounded-lg hover:bg-red-100">
                        POPIA Purge Profile
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>



<div class="bg-gray-100 min-h-screen py-8">

    <div class="max-w-7xl mx-auto px-4">

        <div class="bg-white rounded-3xl shadow-xl border border-gray-200 overflow-hidden">

            <div class="flex gap-6 p-6 bg-gray-50">

                <!-- LEFT SIDEBAR -->
                <div class="w-80">
                    <div class="w-80 space-y-4">



                      
                        <!---data-->
                        <div class="bg-white rounded-xl shadow p-4">

                            <h3 class="text-sm font-semibold mb-3">PROFILE INTEGRITY METER</h3>

                            @*<div class="w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-green-500 h-2 rounded-full"
                                     style="width:@ViewBag.Completion%"></div>
                            </div>

                            <p class="text-xs mt-1 text-gray-500">
                                @ViewBag.Completion% Complete
                            </p>*@

                            @if (missing.Count > 0)
                            {
                                <div class="mt-3">
                                    <p class="text-xs text-red-500 font-semibold">Missing Fields:</p>

                                    <ul class="text-xs text-gray-600 mt-1 space-y-1">
                                        @foreach (var m in missing)
                                        {
                                            <li>• @m</li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <p class="text-xs text-green-600 mt-2 font-semibold">
                                    Profile fully completed 🎉
                                </p>
                            }

                        </div>

                        <!-- MENU CARD -->
                        <div class="bg-white rounded-xl shadow p-4">

                            <div class="space-y-2">
                                <a href="@Url.Action("Dashboard", "Candidate")"
                                   class="block text-sm text-green-800 font-semibold px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    Dashboard
                                </a>
                                <a href="@Url.Action("UserProfile", "Candidate")"
                                   class="block text-sm text-gray-700 px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    My Resume Profile
                                </a>
                                <a href="@Url.Action("Index", "WorkExperience")"
                                   class="block text-sm text-gray-700 px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    Work Experience
                                </a>
                                <a href="@Url.Action("Index", "Education")"
                                   class="block text-sm text-gray-700 px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    Education
                                </a>
                                <a href="@Url.Action("MyApplications","Candidate")"
                                   class="block text-sm text-gray-700 px-3 py-2 hover:bg-gray-100 rounded-lg">
                                    My Applications
                                </a>


                            </div>
                        </div>

                       

                        <!-- SUBMISSIONS CARD -->
                        <div class="bg-white rounded-xl shadow p-4">
                            <h3 class="text-sm font-semibold">ACTIONED SUBMISSIONS (0)</h3>
                            <p class="text-xs text-gray-400 mt-2">No submissions made yet.</p>
                        </div>

                    </div>
                </div>

                <!-- MAIN DASHBOARD CONTENT (FORM AREA REPLACED) -->
                <div class="flex-1 space-y-6">

                    <!-- TOP HEADER CARD -->
                    <div class="bg-white rounded-xl shadow p-6">

                        <h1 class="text-2xl font-bold">
                            Welcome Back 👋
                        </h1>

                        <p class="text-sm text-gray-500 mt-1">
                            Here is your profile summary and activity overview.
                        </p>

                    </div>

                    <div class="bg-white rounded-2xl shadow p-6">

                        <!-- HEADER -->
                        <div class="flex justify-between items-center border-b pb-4 mb-6">

                            <div>
                                <h2 class="text-xl font-bold text-gray-800">My Profile</h2>
                                <p class="text-sm text-gray-500">Manage your personal information</p>
                            </div>

                            <button onclick="toggleEdit()"
                                    class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                                Edit Profile
                            </button>

                        </div>

                        <input type="hidden" id="user_id" value="@Model.user_id" />

                        <!-- GRID LAYOUT -->
                        <div class="grid md:grid-cols-2 gap-6">

                            <!-- LEFT COLUMN -->
                            <div class="space-y-5">

                                <!-- FIRST NAME -->
                                <div>
                                    <label class="text-xs text-gray-500">First Name</label>
                                    <p class="view text-sm font-semibold text-gray-800">@Model.first_name</p>
                                    <input class="edit hidden w-full border rounded-lg p-2"
                                           id="first_name"
                                           value="@(Model.first_name ?? "")" />
                                </div>

                                <!-- LAST NAME -->
                                <div>
                                    <label class="text-xs text-gray-500">Last Name</label>
                                    <p class="view text-sm font-semibold text-gray-800">@Model.last_name</p>
                                    <input class="edit hidden w-full border rounded-lg p-2"
                                           id="last_name"
                                           value="@Model.last_name" />
                                </div>

                                <!-- DATE OF BIRTH -->
                                <div>
                                    <label class="text-xs text-gray-500">Date of Birth</label>
                                    <p class="view text-sm font-semibold text-gray-800">
                                        @Model.date_of_birth
                                    </p>

                                    <input type="date"
                                           class="edit hidden w-full border rounded-lg p-2"
                                           id="date_of_birth"
                                           value="@Model.date_of_birth?.ToString(" yyyy-MM-dd")" />
                                </div>

                                <!-- GENDER -->
                                <div>
                                    <label class="text-xs text-gray-500">Gender</label>
                                    <p class="view text-sm font-semibold text-gray-800">@Model.gender</p>

                                    <input class="edit hidden w-full border rounded-lg p-2"
                                           id="gender"
                                           value="@Model.gender" />
                                </div>

                            </div>

                            <!-- RIGHT COLUMN -->
                            <div class="space-y-5">

                                <!-- ID NUMBER -->
                                <div>
                                    <label class="text-xs text-gray-500">ID Number</label>
                                    <p class="view text-sm font-semibold text-gray-800">@Model.id_number</p>

                                    <input class="edit hidden w-full border rounded-lg p-2"
                                           id="id_number"
                                           value="@Model.id_number" />
                                </div>

                                <!-- ADDRESS -->
                                <div>
                                    <label class="text-xs text-gray-500">Address</label>
                                    <p class="view text-sm font-semibold text-gray-800">@Model.address</p>

                                    <input class="edit hidden w-full border rounded-lg p-2"
                                           id="address"
                                           value="@Model.address" />
                                </div>

                                <!-- AVAILABILITY -->
                                <div>
                                    <label class="text-xs text-gray-500">Availability Status</label>
                                    <p class="view text-sm font-semibold text-gray-800">
                                        @Model.availability_status
                                    </p>

                                    <select class="edit hidden w-full border rounded-lg p-2"
                                            id="availability_status">

                                        <option value="Immediately">Immediately</option>
                                        <option value="Two Weeks">Two Weeks</option>
                                        <option value="30 Days">30 Days</option>

                                    </select>
                                </div>

                                <!-- DRIVER'S LICENSE -->
                                <div>
                                    <label class="text-xs text-gray-500">Driver’s License</label>
                                    <p class="view text-sm font-semibold text-gray-800">
                                        @Model.drivers_license
                                    </p>

                                    <select class="edit hidden w-full border rounded-lg p-2"
                                            id="drivers_license">

                                        <option value="Learners">Learners</option>
                                        <option value="Code 8">Code 8</option>
                                        <option value="Code 10">Code 10</option>
                                        <option value="Code 14">Code 14</option>
                                        <option value="No License">No License</option>

                                    </select>
                                </div>

                            </div>

                        </div>

                        <!-- FULL WIDTH SECTION -->
                        <div class="mt-6">

                            <label class="text-xs text-gray-500">Bio</label>

                            <p class="view text-sm font-medium text-gray-700 mt-1">
                                @Model.bio
                            </p>

                            <textarea class="edit hidden w-full border rounded-lg p-3 mt-1"
                                      id="bio">@Model.bio</textarea>

                        </div>

                        <!-- SAVE -->
                        <div class="edit hidden mt-6 text-right">
                            <button onclick="saveProfile()"
                                    class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition">
                                Save Changes
                            </button>
                        </div>

                    </div>




                </div>

            </div>
        </div>
    </div>
</div>

<script>

    function toggleEdit() {
        $(".edit").toggleClass("hidden");
        $(".view").toggleClass("hidden");
    }

    function saveProfile() {

        var data = {
            user_id: $("#user_id").val(),
            first_name: $("#first_name").val(),
            last_name: $("#last_name").val(),
            date_of_birth: $("#date_of_birth").val(),
            gender: $("#gender").val(),
            id_number: $("#id_number").val(),
            address: $("#address").val(),
            availability_status: $("#availability_status").val(),
            drivers_license: $("#drivers_license").val(),
            profile_photo_url: $("#profile_photo_url").val(),
            bio: $("#bio").val(),
            location: $("#location").val()
        };

        $.ajax({
            url: '/Candidate/UpdateProfile',
            type: 'POST',
            data: data,
            success: function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message || "Update failed");
                }
            },
            error: function () {
                alert("Server error");
            }
        });
    }

</script>



