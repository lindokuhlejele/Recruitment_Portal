                            <h3 class="text-sm font-semibold mb-2">
                                QUALIFICATION CV ATTACHMENT
                            </h3>
                         
                            <div class="border-2 border-dashed rounded-lg p-4 text-xs text-gray-500">

                                Click to load qualifying CV<br>
                                PDF, DOC up to 5MB

                            </div>

                        </div>

                        <!-- SUBMISSIONS CARD -->
                        <div class="bg-white rounded-xl shadow p-4">
                            <h3 class="text-sm font-semibold">ACTIONED SUBMISSIONS (0)</h3>
                            <p class="text-xs text-gray-400 mt-2">No submissions made yet.</p>
                        </div>

                    </div>
                </div>

                <!-- MAIN DASHBOARD CONTENT (FORM AREA REPLACED) -->
                <div class="flex-1 space-y-6">

                    <!-- TOP HEADER CARD -->
                    <div class="bg-white rounded-xl shadow p-6">

                        <h1 class="text-2xl font-bold">
                            Welcome Back 👋
                        </h1>

                        <p class="text-sm text-gray-500 mt-1">
                            Here is your profile summary and activity overview.
                        </p>

                    </div>

                    <!-- STATS ROW -->
                    <div class="grid grid-cols-3 gap-4">

                        <div class="bg-white rounded-xl shadow p-4">
                            <p class="text-xs text-gray-500">Profile Completion</p>
                            <h2 class="text-2xl font-bold text-green-600"> @ViewBag.Completion%</h2>
                        </div>

                        <div class="bg-white rounded-xl shadow p-4">
                            <p class="text-xs text-gray-500">Work Experience</p>
                            <h2 class="text-2xl font-bold">3</h2>
                        </div>

                        <div class="bg-white rounded-xl shadow p-4">
                            <p class="text-xs text-gray-500">Job Matches</p>
                            <h2 class="text-2xl font-bold text-blue-600">5</h2>
                        </div>

                    </div>

                    <div class="grid grid-cols-1 gap-4">

                        <div id="skillsSection">
                            @Html.Partial("_DashboardLayout")
                        </div>

                    </div>

                    <!-- QUICK ACTIONS (OPTIONAL) -->
                    <div class="grid grid-cols-1 gap-4">

                        @Html.Partial("_UploadDocuments")

                    </div>
                    <!-- ACTIVITY / DASHBOARD CONTENT AREA (THIS REPLACES YOUR FORM) -->
                    @*<div class="bg-white rounded-xl shadow p-6">

            <h2 class="font-semibold text-lg mb-4">
                Recent Activity
            </h2>

            <div class="space-y-3">

                <div class="flex justify-between text-sm border-b pb-2">
                    <span>Profile updated</span>
                    <span class="text-gray-400">Today</span>
                </div>

                <div class="flex justify-between text-sm border-b pb-2">
                    <span>Work experience added</span>
                    <span class="text-gray-400">Yesterday</span>
                </div>

                <div class="flex justify-between text-sm border-b pb-2">
                    <span>CV uploaded</span>
                    <span class="text-gray-400">2 days ago</span>
                </div>

            </div>

        </div>*@

                </div>

            </div>
        </div>
    </div>
</div>

<div id="documentModal"
     class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50">

    <div class="bg-gray-900 w-full max-w-3xl rounded-xl border border-gray-700 p-6 relative">

        <button onclick="closeDocModal()"
                class="absolute top-3 right-3 text-white text-xl">
            ×
        </button>

        <div id="documentModalContent">
            <!-- Partial loads here -->
        </div>

    </div>

</div>

<script>

    function openDocumentModal() {
        $.ajax({
            url: '/Documents/UploadPartial',
            type: 'GET',

            success: function (html) {
                $("#documentModalContent").html(html);
                $("#documentModal").removeClass("hidden").addClass("flex");
            },

            error: function () {
                alert("Failed to load upload form");
            }
        });
    }

    function closeDocModal() {
        $("#documentModal").addClass("hidden").removeClass("flex");
    }
</script>

