<!-- COMPANY MODAL -->
<div id="companyModal"
     class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center">

    <div class="bg-[#111827] w-full max-w-4xl rounded-2xl shadow-2xl border border-[#D4AF37]">

        <!-- HEADER TABS -->
        <div class="flex">

            <button id="companyRegisterTab"
                    type="button"
                    onclick="showCompanyRegister()"
                    class="w-1/2 py-4 bg-[#D4AF37] text-black font-bold rounded-tl-2xl">
                Register Company
            </button>

            <button id="companyLoginTab"
                    type="button"
                    onclick="showCompanyLogin()"
                    class="w-1/2 py-4 bg-gray-800 text-white font-bold rounded-tr-2xl">
                Company Login
            </button>

        </div>

        <!-- REGISTER -->
        <div id="companyRegisterSection" class="p-8">

            <h2 class="text-3xl text-white font-bold mb-6">Register Your Company</h2>

            <div class="grid grid-cols-2 gap-4">

                <input id="companyName" class="bg-gray-800 text-white p-3 rounded-lg" placeholder="Company Name">

                <input id="companyRegNumber" class="bg-gray-800 text-white p-3 rounded-lg" placeholder="Registration Number">

                <input id="companyIndustry" class="bg-gray-800 text-white p-3 rounded-lg" placeholder="Industry">

                <select id="companyDistrictId" class="bg-gray-800 text-white p-3 rounded-lg">

                    <option value="">Select District</option>

                    @if (ViewBag.Districts != null)
                    {
                        foreach (var d in ViewBag.Districts)
                        {
                            <option value="@d.id">@d.name</option>
                        }
                    }

                </select>

                <input id="companyContactPerson" class="bg-gray-800 text-white p-3 rounded-lg" placeholder="Contact Person">

                <input id="companyEmail" class="bg-gray-800 text-white p-3 rounded-lg" placeholder="Company Email">

                <input id="companyPhone" class="bg-gray-800 text-white p-3 rounded-lg" placeholder="Phone">
                <input id="companyWebsite"
                       placeholder="Company Website (optional)"
                       class="bg-gray-800 text-white p-3 rounded-lg">

                <input id="companyPassword"
                       type="password"
                       placeholder="Password"
                       class="bg-gray-800 text-white p-3 rounded-lg">

                <input id="companyConfirmPassword"
                       type="password"
                       placeholder="Confirm Password"
                       class="bg-gray-800 text-white p-3 rounded-lg">

            </div>

            <button onclick="registerCompany()"
                    class="mt-6 w-full bg-[#D4AF37] text-black font-bold py-3 rounded-xl">
                Register Company
            </button>

        </div>

        <!-- LOGIN -->
        <div id="companyLoginSection" class="p-8 hidden">

            <h2 class="text-3xl text-white font-bold mb-6">Company Login</h2>

            <div class="space-y-4">

                <input id="companyLoginEmail" class="w-full bg-gray-800 text-white p-3 rounded-lg" placeholder="Email">

                <input id="companyLoginPassword" type="password" class="w-full bg-gray-800 text-white p-3 rounded-lg" placeholder="Password">

            </div>

            <button onclick="loginCompany()"
                    class="mt-6 w-full bg-[#D4AF37] text-black font-bold py-3 rounded-xl">
                Login
            </button>

        </div>

    </div>
</div>



<!-- AUTH MODAL -->

<div id="authModal"
     class="fixed inset-0 bg-black bg-opacity-60 hidden items-center justify-center z-50">

    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">

        <div class="flex justify-between items-center p-5 border-b">
            <h2 class="font-bold text-xl text-gray-800">Royal Recruitment Portal</h2>
            <button onclick="closeAuthModal()" class="text-2xl">&times;</button>
        </div>

        <div class="flex border-b">

            <button id="youthLoginTab" class="flex-1 py-4 font-semibold border-b-2 border-blue-600 text-blue-600">
                Login
            </button>

            <button id="youthRegisterTab" class="flex-1 py-4 font-semibold">
                Register
            </button>

        </div>

        <!-- LOGIN -->
        <div id="youthLoginPanel" class="p-6">

            <input id="youthLoginEmail" class="w-full border p-3 mb-3 rounded-lg" placeholder="Email">
            <input id="youthLoginPassword" type="password" class="w-full border p-3 mb-4 rounded-lg" placeholder="Password">

            <button onclick="loginUser()" class="w-full bg-blue-600 text-white py-3 rounded-lg">
                Login
            </button>

        </div>

        <!-- REGISTER -->
        <div id="youthRegisterPanel" class="p-6 hidden">

            <input id="firstName" class="w-full border p-3 mb-3 rounded-lg" placeholder="First Name">
            <input id="lastName" class="w-full border p-3 mb-3 rounded-lg" placeholder="Last Name">
            <input id="youthRegisterEmail" class="w-full border p-3 mb-3 rounded-lg" placeholder="Email">
            <input id="phone" class="w-full border p-3 mb-3 rounded-lg" placeholder="Phone">
            <input id="youthRegisterPassword" type="password" class="w-full border p-3 mb-4 rounded-lg" placeholder="Password">

            <button onclick="registerUser()" class="w-full bg-emerald-600 text-white py-3 rounded-lg">
                Register
            </button>

        </div>

    </div>
</div>



    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>

    //// ---------------- COMPANY MODAL ----------------

    function openCompanyModal() {
        $("#companyModal").removeClass("hidden").addClass("flex");
}

    function closeCompanyModal() {
        $("#companyModal").addClass("hidden");
}

    function showCompanyRegister() {
        $("#companyRegisterSection").show();
    $("#companyLoginSection").hide();
}

    function showCompanyLogin() {
        $("#companyLoginSection").show();
    $("#companyRegisterSection").hide();
}

    function registerCompany() {

        var data = {

            CompanyName: $("#companyName").val(),
            RegistrationNumber: $("#companyRegNumber").val(),
            Industry: $("#companyIndustry").val(),
            DistrictId: $("#companyDistrictId").val(),

            ContactPerson: $("#companyContactPerson").val(),

            Email: $("#companyEmail").val(),
            Phone: $("#companyPhone").val(),

            Website: $("#companyWebsite").val(),   // ✅ NEW

            Password: $("#companyPassword").val(),
            ConfirmPassword: $("#companyConfirmPassword").val() // ✅ NEW
        };

        $.ajax({
            url: '/Account/CompanyRegister',
            type: 'POST',
            data: data,

            success: function (response) {

                if (response.success) {
                    alert(response.message);
                    showCompanyLogin();
                } else {
                    alert(response.message);
                }
            },

            error: function () {
                alert("Registration failed");
            }
        });
    }

    function loginCompany() {

var data = {
        Email: $("#companyLoginEmail").val(),
    Password: $("#companyLoginPassword").val()
};

    $.post("/Account/CompanyLogin", data, function (res) {
    if (res.success) {
        window.location.href = res.redirectUrl;
    } else {
        alert(res.message);
    }
});
}

    //// ---------------- YOUTH MODAL ----------------

    function openAuthModal() {
        $("#authModal").removeClass("hidden").addClass("flex");
    showYouthLogin();
}

    function closeAuthModal() {
        $("#authModal").addClass("hidden");
}

    function showYouthLogin() {
        $("#youthLoginPanel").show();
    $("#youthRegisterPanel").hide();
}

    function showYouthRegister() {
        $("#youthRegisterPanel").show();
    $("#youthLoginPanel").hide();
}

    function loginUser() {

var data = {
        Email: $("#youthLoginEmail").val(),
    Password: $("#youthLoginPassword").val()
};

    $.post("/Account/Login", data, function (res) {
    if (res.success) {
        window.location.href = res.redirectUrl;
    } else {
        alert(res.message);
    }
});
}

    function registerUser() {

var data = {
        FirstName: $("#firstName").val(),
    LastName: $("#lastName").val(),
    Email: $("#youthRegisterEmail").val(),
    Phone: $("#phone").val(),
    Password: $("#youthRegisterPassword").val()
};

    $.ajax({
        url: "/Account/Register",
    type: "POST",
    contentType: "application/json",
    data: JSON.stringify(data),
    success: function (res) {
        if (res.success) {
        window.location.href = res.redirectUrl;
        } else {
        alert(res.message);
        }
    }
});
}

</script>


</script>

