    <div class="absolute inset-0">
        <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644"
             class="w-full h-full object-cover opacity-60" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 to-[#0A5230]/90"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 py-24 grid lg:grid-cols-12 gap-10">

        <!-- LEFT -->
        <div class="lg:col-span-7 space-y-6">

            <span class="text-[#D4AF37] font-bold text-xs uppercase">
                Royal Development Initiative
            </span>

            <h2 class="text-4xl font-bold leading-tight">
                Empowering the Youth of KwaZulu Through The Royal Recruitment Portal
            </h2>

            <p class="text-gray-200">
                The Royal Recruitment Portal is a strategic employment and workforce development initiative of the Zulu Royal House, established to improve the livelihoods of its citizens and contribute towards building a vibrant, inclusive, and economically active Kingdom.
            </p>

            <div class="flex gap-4 flex-wrap">
                <button type="button"
                        onclick="location.href='@Url.Action("Register", "Account")'"
                        class="bg-[#D4AF37] text-black px-6 py-3 rounded-xl font-bold">
                    Create Youth Portal
                </button>

                <button onclick="openCompanyModal()"
                        class="bg-[#D4AF37] text-black px-6 py-3 rounded-xl font-bold hover:scale-105 transition">
                    Company Registration
                </button>
            </div>

        </div>

        <!-- RIGHT -->
        <div class="lg:col-span-5 bg-white/10 p-6 rounded-2xl backdrop-blur">

            <h3 class="text-[#D4AF37] font-bold mb-4">Why Royal Portal?</h3>

            <ul class="space-y-4 text-sm">

                <li>
                    <strong>Verified Talent</strong><br />
                    <span class="text-gray-300">Access verified KZN candidate data</span>
