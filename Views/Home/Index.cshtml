        <h2 class="text-3xl font-bold text-gray-900 leading-snug">
            A Royal Commitment to Employment, Empowerment, and Economic Growth.
        </h2>
    </div>

    <!-- CARDS GRID ONLY -->
    <div class="grid md:grid-cols-3 gap-6">

