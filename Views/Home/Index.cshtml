<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>

    function showLoginTab() {

        $('#loginPanel').removeClass('hidden');
        $('#registerPanel').addClass('hidden');

        $('#loginTab').addClass('border-blue-600 text-blue-600');
        $('#registerTab').removeClass('border-blue-600 text-blue-600');
    }

    function showRegisterTab() {

        $('#registerPanel').removeClass('hidden');
        $('#loginPanel').addClass('hidden');

        $('#registerTab').addClass('border-blue-600 text-blue-600');
        $('#loginTab').removeClass('border-blue-600 text-blue-600');
    }

    function openAuthModal() {
        $('#authModal').removeClass('hidden').addClass('flex');
        showLoginTab();
    }

    function closeAuthModal() {
        $('#authModal').removeClass('flex').addClass('hidden');
    }

    function loginUser() {

        let email = $('#loginEmail').val();
        let password = $('#loginPassword').val();

        if (!email || !password) {
            alert('Enter email and password');
            return;
        }

        $.ajax({
            url: '/Account/Login',
            type: 'POST',
            data: { email: email, password: password },

            success: function (res) {
                if (res.success) {
                    window.location.href = res.redirectUrl;
                } else {
                    alert(res.message);
                }
            },

            error: function () {
                alert('Login failed');
            }
        });
    }

    function registerUser() {

        let model = {
            FirstName: $('#firstName').val(),
            LastName: $('#lastName').val(),
            Email: $('#registerEmail').val(),
            Phone: $('#phone').val(),
            Password: $('#registerPassword').val()
        };

        if (!model.FirstName || !model.LastName || !model.Email || !model.Phone || !model.Password) {
            alert('Please complete all required fields');
            return;
        }

        $.ajax({
            url: '/Account/Register',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(model),

            success: function (res) {
                if (res.success) {
                    window.location.href = res.redirectUrl;
                } else {
                    alert(res.message);
                }
            },

            error: function () {
                alert('Registration failed');
            }
        });
    }

    // TAB EVENTS (ONLY ONCE)
    $(document).on('click', '#loginTab', showLoginTab);
    $(document).on('click', '#registerTab', showRegisterTab);

</script>-->
