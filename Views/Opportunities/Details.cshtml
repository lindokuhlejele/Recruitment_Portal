

@model Recruitment_Portal.Models.OpportunityDetailsVM

@{
    ViewBag.Title = "Opportunity Details";
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<div class="min-h-screen bg-gray-950 text-white">

    <div class="max-w-6xl mx-auto px-6 py-10">

        <!-- HEADER -->

        <div class="bg-gray-900 rounded-2xl p-8 border border-gray-800">

            <div class="flex justify-between items-start">

                <div>

                    <span class="bg-green-700 px-3 py-1 rounded-full text-xs">
                        @Model.Status
                    </span>

                    <h1 class="text-4xl font-bold mt-4">
                        @Model.Title
                    </h1>

                    <div class="mt-3 text-gray-400">

                        @Model.CompanyName

                        @if (!string.IsNullOrEmpty(Model.Industry))
                        {
                            <span>
                                • @Model.Industry
                            </span>
                        }

                    </div>

                </div>

                <div class="text-right">

                    <div class="text-[#D4AF37] text-3xl font-bold">

                        @(Model.Stipend.HasValue
                            ? "R " + Model.Stipend.Value.ToString("N2")
                            : "Negotiable")

                    </div>

                    <div class="text-gray-400 text-sm mt-2">

                        Closing:
                        @Model.ClosingDate?.ToString("dd MMM yyyy")

                    </div>

                </div>

            </div>

        </div>

        <!-- INFO CARDS -->

        <div class="grid md:grid-cols-3 gap-6 mt-8">

            <div class="bg-gray-900 rounded-xl p-5 border border-gray-800">

                <div class="text-gray-400 text-sm">
                    Category
                </div>

                <div class="font-semibold mt-2">
                    @Model.Category
                </div>

            </div>

            <div class="bg-gray-900 rounded-xl p-5 border border-gray-800">

                <div class="text-gray-400 text-sm">
                    Location
                </div>

                <div class="font-semibold mt-2">
                    @Model.Location
                </div>

            </div>

            <div class="bg-gray-900 rounded-xl p-5 border border-gray-800">

                <div class="text-gray-400 text-sm">
                    District
                </div>

                <div class="font-semibold mt-2">
                    @Model.District
                </div>

            </div>

        </div>

        <!-- DESCRIPTION -->

        <div class="bg-gray-900 rounded-2xl p-8 mt-8 border border-gray-800">

            <h2 class="text-2xl font-bold mb-4">
                Opportunity Description
            </h2>

            <div class="text-gray-300 whitespace-pre-wrap">
                @Model.Description
            </div>

        </div>

        <!-- REQUIREMENTS -->

        <div class="bg-gray-900 rounded-2xl p-8 mt-8 border border-gray-800">

            <h2 class="text-2xl font-bold mb-4">
                Requirements
            </h2>

            <div class="text-gray-300 whitespace-pre-wrap">
                @Model.Requirements
            </div>

        </div>

        <!-- APPLY SECTION -->

        <div class="bg-gray-900 rounded-2xl p-8 mt-8 border border-gray-800">

            <div class="flex justify-between items-center">

                <div>

                    <h3 class="text-xl font-bold">
                        Interested in this opportunity?
                    </h3>

                    <p class="text-gray-400">
                        Submit your application today.
                    </p>

                </div>

                @if (ViewBag.AlreadyApplied == true)
                {
                    <button class="bg-green-700 px-6 py-3 rounded-xl font-bold cursor-not-allowed">
                        ✓ Applied
                    </button>
                }
                else
                {
                    <button onclick="applyOpportunity('@Model.Id')"
                            class="bg-[#D4AF37] text-black px-8 py-3 rounded-xl font-bold">
                        Apply Now
                    </button>
                }

            </div>

        </div>

        <!-- BACK -->

        <div class="mt-8">

            <a href="@Url.Action("Index","Opportunities")"
               class="text-[#D4AF37] font-semibold">

                ← Back to Opportunities

            </a>

        </div>

    </div>

</div>

<script>

function applyOpportunity(id)
{
    $.ajax({

        url: '/Applications/Apply',
        type: 'POST',

        data: {
            opportunityId: id
        },

        success: function(res)
        {
            if(res.success)
            {
                alert(res.message);
                location.reload();
            }
            else
            {
                alert(res.message);
            }
        },

        error: function()
        {
            alert("Failed to submit application");
        }
    });
}

</script>
